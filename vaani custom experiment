def prepare_numeric_features(
    df,
    remove_columns
):

    data = df.copy()

    for column in remove_columns:

        if column in data.columns:

            data = data.drop(
                columns=[column]
            )

    data = data.select_dtypes(
        include=[np.number]
    )

    data = data.replace(
        [np.inf, -np.inf],
        np.nan
    )

    data = data.dropna(
        axis=1,
        how="all"
    )

    data = data.fillna(
        data.median(
            numeric_only=True
        )
    )

    return data


