def find_files(path):

    files = []

    for root, dirs, filenames in os.walk(path):

        for filename in filenames:

            full_path = os.path.join(
                root,
                filename
            )

            if filename.lower().endswith(
                (".csv", ".data", ".txt")
            ):

                files.append(full_path)

    return files


